// Apollo Group TV — database schema (MySQL / MariaDB on Hostinger)
// Auth models (User, Session, Account, Verification, RateLimit) follow the
// Better Auth core schema. Everything else is application data.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider     = "mysql"
  url          = env("DATABASE_URL")
  relationMode = "foreignKeys"
}

// ─── Enums ──────────────────────────────────────────────────────────────────

enum Role {
  USER
  SUPPORT
  ADMIN
}

enum UserStatus {
  ACTIVE
  SUSPENDED
}

enum BillingInterval {
  MONTHLY
  QUARTERLY
  SEMIANNUAL
  YEARLY
  ONE_TIME
}

enum SubscriptionStatus {
  PENDING
  ACTIVE
  PAST_DUE
  CANCELED
  EXPIRED
}

enum PaymentStatus {
  PENDING
  SUCCEEDED
  FAILED
  REFUNDED
  PARTIALLY_REFUNDED
}

// An order is the customer's invoice. PENDING = awaiting payment while the reservation runs.
enum OrderStatus {
  PENDING
  PENDING_CONFIRMATION
  PAID
  UNDERPAID
  EXPIRED
  FAILED
  CANCELED
}

// BITCOIN payments are verified on-chain; MANUAL ones (Cash App, Zelle…) are confirmed by an admin.
enum PaymentMethodKind {
  BITCOIN
  MANUAL
}

enum PaymentRequestStatus {
  AWAITING
  DETECTED
  CONFIRMED
  UNDERPAID
  REPORTED
  EXPIRED
  SUPERSEDED
}

enum ReviewStatus {
  PENDING
  APPROVED
  REJECTED
}

enum ReferralStatus {
  PENDING
  QUALIFIED
  REWARDED
  REJECTED
}

enum RewardStatus {
  PENDING
  APPROVED
  ISSUED
  REJECTED
}

enum TicketStatus {
  OPEN
  IN_PROGRESS
  WAITING_ON_CUSTOMER
  RESOLVED
  CLOSED
}

enum TicketPriority {
  LOW
  NORMAL
  HIGH
  URGENT
}

// ─── Auth (Better Auth) ─────────────────────────────────────────────────────

model User {
  id                  String     @id
  name                String     @db.VarChar(120)
  email               String     @unique @db.VarChar(255)
  // Optional phone or WhatsApp number given at sign-up, so staff can help with activation.
  phone               String?    @db.VarChar(32)
  emailVerified       Boolean    @default(false)
  image               String?    @db.VarChar(512)
  role                Role       @default(USER)
  status              UserStatus @default(ACTIVE)
  referralCode        String?    @unique @db.VarChar(16)
  marketingOptIn      Boolean    @default(false)
  productUpdatesOptIn Boolean    @default(true)
  // Set by the unsubscribe link in reminder emails; stops the "finish your purchase" sequence.
  remindersOptOut     Boolean    @default(false)
  // Two-step sign-in with an authenticator app (Better Auth two-factor plugin).
  twoFactorEnabled    Boolean    @default(false)
  createdAt           DateTime   @default(now())
  updatedAt           DateTime   @updatedAt

  sessions         Session[]
  accounts         Account[]
  subscriptions    Subscription[]
  orders           Order[]
  payments         Payment[]
  reviews          Review[]
  referralsMade    Referral[]        @relation("Referrer")
  referredBy       Referral?         @relation("Referee")
  rewards          ReferralReward[]
  tickets          SupportTicket[]   @relation("TicketOwner")
  assignedTickets  SupportTicket[]   @relation("TicketAssignee")
  supportMessages  SupportMessage[]
  notifications    Notification[]
  playerCredential PlayerCredential?
  auditLogs        AuditLog[]
  emailReminders   EmailReminder[]
  twoFactors       TwoFactor[]

  @@index([role])
  @@index([status])
  @@index([createdAt])
  @@map("users")
}

model Session {
  id        String   @id
  expiresAt DateTime
  token     String   @unique @db.VarChar(255)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  ipAddress String?  @db.VarChar(64)
  userAgent String?  @db.Text
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("sessions")
}

// Authenticator-app secret and recovery codes, both encrypted with BETTER_AUTH_SECRET.
model TwoFactor {
  id                      String    @id
  secret                  String    @db.Text
  backupCodes             String    @db.Text
  userId                  String
  user                    User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  verified                Boolean   @default(true)
  failedVerificationCount Int       @default(0)
  lockedUntil             DateTime?

  @@index([userId])
  @@map("two_factors")
}

model Account {
  id                    String    @id
  accountId             String
  providerId            String
  userId                String
  user                  User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  accessToken           String?   @db.Text
  refreshToken          String?   @db.Text
  idToken               String?   @db.Text
  accessTokenExpiresAt  DateTime?
  refreshTokenExpiresAt DateTime?
  scope                 String?   @db.Text
  password              String?   @db.Text
  createdAt             DateTime  @default(now())
  updatedAt             DateTime  @updatedAt

  @@index([userId])
  @@map("accounts")
}

model Verification {
  id         String   @id
  identifier String   @db.VarChar(255)
  value      String   @db.Text
  expiresAt  DateTime
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@index([identifier])
  @@map("verifications")
}

model RateLimit {
  id          String @id
  key         String @unique @db.VarChar(255)
  count       Int
  lastRequest BigInt

  @@map("rate_limits")
}

// ─── Catalog ────────────────────────────────────────────────────────────────

model Plan {
  id          String          @id @default(cuid())
  slug        String          @unique @db.VarChar(80)
  name        String          @db.VarChar(120)
  description String          @db.Text
  priceCents  Int
  currency    String          @default("USD") @db.Char(3)
  interval    BillingInterval
  // One-time payment for a fixed access period (no automatic renewal).
  oneTime     Boolean         @default(false)
  features    Json
  highlighted Boolean         @default(false)
  isActive    Boolean         @default(true)
  sortOrder   Int             @default(0)
  createdAt   DateTime        @default(now())
  updatedAt   DateTime        @updatedAt

  subscriptions Subscription[]
  orders        Order[]

  @@index([isActive, sortOrder])
  @@map("plans")
}

model ChannelCategory {
  id        String    @id @default(cuid())
  slug      String    @unique @db.VarChar(80)
  name      String    @db.VarChar(120)
  sortOrder Int       @default(0)
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  channels  Channel[]

  @@map("channel_categories")
}

model Channel {
  id          String          @id @default(cuid())
  slug        String          @unique @db.VarChar(120)
  name        String          @db.VarChar(160)
  description String?         @db.Text
  logoUrl     String?         @db.VarChar(512)
  country     String?         @db.VarChar(64)
  language    String?         @db.VarChar(64)
  isHd        Boolean         @default(false)
  isActive    Boolean         @default(true)
  categoryId  String
  category    ChannelCategory @relation(fields: [categoryId], references: [id], onDelete: Restrict)
  createdAt   DateTime        @default(now())
  updatedAt   DateTime        @updatedAt

  @@index([categoryId])
  @@index([isActive, name])
  @@map("channels")
}

// ─── Commerce ───────────────────────────────────────────────────────────────

model Subscription {
  id                     String             @id @default(cuid())
  userId                 String
  user                   User               @relation(fields: [userId], references: [id], onDelete: Cascade)
  planId                 String
  plan                   Plan               @relation(fields: [planId], references: [id], onDelete: Restrict)
  status                 SubscriptionStatus @default(PENDING)
  currentPeriodStart     DateTime?
  currentPeriodEnd       DateTime?
  cancelAtPeriodEnd      Boolean            @default(false)
  providerSubscriptionId String?            @unique @db.VarChar(255)
  // IPTV login details (username, password, M3U/MAG URLs, Xtream login), AES-256-GCM encrypted JSON.
  accessEnc              String?            @db.Text
  connectionLimit        Int                @default(1)
  activatedAt            DateTime?
  expiryNotifiedAt       DateTime?
  createdAt              DateTime           @default(now())
  updatedAt              DateTime           @updatedAt
  payments               Payment[]
  order                  Order?

  @@index([userId, status])
  @@index([status])
  @@map("subscriptions")
}

model Order {
  id                String           @id @default(cuid())
  // Customer-facing invoice number, e.g. AGT-7K3F9Q2M.
  number            String?          @unique @db.VarChar(20)
  userId            String
  user              User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  planId            String
  plan              Plan             @relation(fields: [planId], references: [id], onDelete: Restrict)
  // Copied from the plan when the invoice is created, so later price edits never change it.
  amountCents       Int
  currency          String           @db.Char(3)
  status            OrderStatus      @default(PENDING)
  // End of the reservation window; unpaid invoices expire after this.
  expiresAt         DateTime?
  methodId          String?
  method            PaymentMethod?   @relation(fields: [methodId], references: [id], onDelete: SetNull)
  // Reference the customer gave for a manual payment (unverified until an admin confirms).
  customerReference String?          @db.VarChar(255)
  note              String?          @db.Text
  // When the customer pressed "I Have Paid" (a request for review, not a confirmation).
  reportedAt        DateTime?
  paidAt            DateTime?
  subscriptionId    String?          @unique
  subscription      Subscription?    @relation(fields: [subscriptionId], references: [id], onDelete: SetNull)
  createdAt         DateTime         @default(now())
  updatedAt         DateTime         @updatedAt
  payments          Payment[]
  requests          PaymentRequest[]

  @@index([userId, status])
  @@index([status])
  @@map("orders")
}

model PaymentMethod {
  id           String            @id @default(cuid())
  name         String            @db.VarChar(80)
  // Short line under the name: "Any wallet", "USA", "Credit Card".
  subtitle     String            @db.VarChar(80)
  country      String?           @db.VarChar(80)
  description  String?           @db.VarChar(240)
  kind         PaymentMethodKind
  logoUrl      String?           @db.VarChar(512)
  // Fallback tile when there is no logo: a glyph on a brand colour.
  glyph        String?           @db.VarChar(4)
  accent       String?           @db.VarChar(7)
  // Manual methods: the account customers pay ($cashtag, Zelle email…). Bitcoin uses the wallet in crypto settings.
  account      String?           @db.VarChar(255)
  instructions String?           @db.Text
  paymentUrl   String?           @db.VarChar(512)
  network      String?           @db.VarChar(80)
  isActive     Boolean           @default(true)
  sortOrder    Int               @default(0)
  createdAt    DateTime          @default(now())
  updatedAt    DateTime          @updatedAt
  orders       Order[]
  requests     PaymentRequest[]

  @@index([isActive, sortOrder])
  @@map("payment_methods")
}

// One attempt to pay an invoice with a method. Bitcoin requests lock the BTC/USD rate until expiresAt.
model PaymentRequest {
  id            String               @id @default(cuid())
  orderId       String
  order         Order                @relation(fields: [orderId], references: [id], onDelete: Cascade)
  methodId      String?
  method        PaymentMethod?       @relation(fields: [methodId], references: [id], onDelete: SetNull)
  kind          PaymentMethodKind
  status        PaymentRequestStatus @default(AWAITING)
  usdCents      Int
  rateUsd       Decimal?             @db.Decimal(14, 2)
  priceSource   String?              @db.VarChar(20)
  amountSats    Int?
  address       String?              @db.VarChar(120)
  network       String?              @db.VarChar(20)
  expiresAt     DateTime
  txid          String?              @unique @db.VarChar(80)
  receivedSats  Int?
  confirmations Int                  @default(0)
  lastCheckedAt DateTime?
  createdAt     DateTime             @default(now())
  updatedAt     DateTime             @updatedAt

  @@index([orderId])
  @@index([address, status])
  @@index([status])
  @@map("payment_requests")
}

// Fake chain used only by the local payments sandbox (PAYMENTS_SANDBOX on a localhost site).
model SandboxTransaction {
  id            String   @id @default(cuid())
  address       String   @db.VarChar(120)
  txid          String   @unique @db.VarChar(80)
  valueSats     Int
  confirmations Int      @default(0)
  createdAt     DateTime @default(now())

  @@index([address])
  @@map("sandbox_transactions")
}

// Payment rows are written only by verified payment-provider webhooks.
model Payment {
  id                String        @id @default(cuid())
  userId            String
  user              User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  orderId           String?
  order             Order?        @relation(fields: [orderId], references: [id], onDelete: SetNull)
  subscriptionId    String?
  subscription      Subscription? @relation(fields: [subscriptionId], references: [id], onDelete: SetNull)
  amountCents       Int
  currency          String        @db.Char(3)
  status            PaymentStatus
  provider          String        @db.VarChar(40)
  providerReference String        @unique @db.VarChar(255)
  createdAt         DateTime      @default(now())
  updatedAt         DateTime      @updatedAt

  @@index([userId])
  @@index([status])
  @@index([createdAt])
  @@map("payments")
}

// ─── Content ────────────────────────────────────────────────────────────────

model Review {
  id          String       @id @default(cuid())
  userId      String
  user        User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  rating      Int
  title       String       @db.VarChar(120)
  body        String       @db.Text
  status      ReviewStatus @default(PENDING)
  isVerified  Boolean      @default(false)
  moderatedAt DateTime?
  createdAt   DateTime     @default(now())
  updatedAt   DateTime     @updatedAt

  @@index([status, createdAt])
  @@index([userId])
  @@map("reviews")
}

model Faq {
  id          String   @id @default(cuid())
  category    String   @db.VarChar(80)
  question    String   @db.VarChar(255)
  answer      String   @db.Text
  sortOrder   Int      @default(0)
  isPublished Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([isPublished, category, sortOrder])
  @@map("faqs")
}

// ─── Referrals ──────────────────────────────────────────────────────────────

model Referral {
  id          String           @id @default(cuid())
  referrerId  String
  referrer    User             @relation("Referrer", fields: [referrerId], references: [id], onDelete: Cascade)
  refereeId   String           @unique
  referee     User             @relation("Referee", fields: [refereeId], references: [id], onDelete: Cascade)
  status      ReferralStatus   @default(PENDING)
  qualifiedAt DateTime?
  createdAt   DateTime         @default(now())
  updatedAt   DateTime         @updatedAt
  rewards     ReferralReward[]

  @@index([referrerId, status])
  @@map("referrals")
}

model ReferralReward {
  id          String       @id @default(cuid())
  referralId  String
  referral    Referral     @relation(fields: [referralId], references: [id], onDelete: Cascade)
  userId      String
  user        User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  description String       @db.VarChar(255)
  status      RewardStatus @default(PENDING)
  createdAt   DateTime     @default(now())
  updatedAt   DateTime     @updatedAt

  @@index([userId])
  @@index([referralId])
  @@map("referral_rewards")
}

// ─── Support ────────────────────────────────────────────────────────────────

model SupportTicket {
  id         String           @id @default(cuid())
  userId     String
  user       User             @relation("TicketOwner", fields: [userId], references: [id], onDelete: Cascade)
  assigneeId String?
  assignee   User?            @relation("TicketAssignee", fields: [assigneeId], references: [id], onDelete: SetNull)
  subject    String           @db.VarChar(160)
  status     TicketStatus     @default(OPEN)
  priority   TicketPriority   @default(NORMAL)
  resolvedAt DateTime?
  createdAt  DateTime         @default(now())
  updatedAt  DateTime         @updatedAt
  messages   SupportMessage[]

  @@index([userId, status])
  @@index([status, updatedAt])
  @@index([assigneeId])
  @@map("support_tickets")
}

model SupportMessage {
  id        String        @id @default(cuid())
  ticketId  String
  ticket    SupportTicket @relation(fields: [ticketId], references: [id], onDelete: Cascade)
  authorId  String
  author    User          @relation(fields: [authorId], references: [id], onDelete: Cascade)
  body      String        @db.Text
  isStaff   Boolean       @default(false)
  createdAt DateTime      @default(now())

  @@index([ticketId, createdAt])
  @@map("support_messages")
}

// ADMIN notifications go to each admin's admin bell, separate from their own customer notifications.
enum NotificationAudience {
  USER
  ADMIN
}

model Notification {
  id        String               @id @default(cuid())
  userId    String
  user      User                 @relation(fields: [userId], references: [id], onDelete: Cascade)
  audience  NotificationAudience @default(USER)
  title     String               @db.VarChar(160)
  body      String               @db.Text
  href      String?              @db.VarChar(255)
  readAt    DateTime?
  createdAt DateTime             @default(now())

  @@index([userId, readAt])
  @@index([userId, audience, readAt])
  @@map("notifications")
}

// ─── Contact ────────────────────────────────────────────────────────────────

enum ContactStatus {
  NEW
  READ
  ARCHIVED
}

// Messages from the public contact form (visitors may not have an account).
model ContactMessage {
  id        String        @id @default(cuid())
  name      String        @db.VarChar(120)
  email     String        @db.VarChar(255)
  topic     String        @db.VarChar(40)
  subject   String        @db.VarChar(160)
  message   String        @db.Text
  status    ContactStatus @default(NEW)
  userId    String?       @db.VarChar(64)
  createdAt DateTime      @default(now())
  updatedAt DateTime      @updatedAt

  @@index([status, createdAt])
  @@map("contact_messages")
}

// ─── Admin ──────────────────────────────────────────────────────────────────

model AuditLog {
  id         String   @id @default(cuid())
  actorId    String?
  actor      User?    @relation(fields: [actorId], references: [id], onDelete: SetNull)
  action     String   @db.VarChar(80)
  targetType String   @db.VarChar(40)
  targetId   String?  @db.VarChar(64)
  metadata   Json?
  ipAddress  String?  @db.VarChar(64)
  createdAt  DateTime @default(now())

  @@index([createdAt])
  @@index([actorId])
  @@index([targetType, targetId])
  @@map("audit_logs")
}

model SiteSetting {
  key       String   @id @db.VarChar(80)
  value     Json
  updatedAt DateTime @updatedAt

  @@map("site_settings")
}

// ─── Player credentials ─────────────────────────────────────────────────────
// Streaming-line details staff issue to a customer for third-party players (Xtream login / M3U).
// Secrets are encrypted at rest (src/lib/crypto.ts); only the owner and admins can read them.
model PlayerCredential {
  id          String   @id @default(cuid())
  userId      String   @unique
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  username    String   @db.VarChar(120)
  passwordEnc String   @db.Text
  serverUrl   String?  @db.VarChar(255)
  m3uUrlEnc   String?  @db.Text
  updatedById String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@map("player_credentials")
}

// One row per reminder email sent, so each step of the sequence goes out at most once per customer.
model EmailReminder {
  id     String   @id @default(cuid())
  userId String
  user   User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  kind   String   @db.VarChar(40)
  sentAt DateTime @default(now())

  @@unique([userId, kind])
  @@index([sentAt])
  @@map("email_reminders")
}
