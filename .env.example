# ─────────────────────────────────────────────────────────────────────────────
# Apollo Group TV — environment variables
# Copy to .env (local) or set in Hostinger hPanel → Node.js → Environment variables.
# Placeholders only. Never commit real values.
# ─────────────────────────────────────────────────────────────────────────────

# Public URL of the site, no trailing slash. Used for canonical URLs, sitemap,
# emails and auth callbacks. Changing it requires a rebuild.
NEXT_PUBLIC_SITE_URL="https://apollogroupr.tv"

# ── Database (MySQL / MariaDB) ───────────────────────────────────────────────
# On Hostinger, the app connects to 127.0.0.1:3306 (not the srvNNNN.hstgr.io host).
# URL-encode special characters in the password (e.g. @ → %40).
DATABASE_URL="mysql://DB_USER:DB_PASSWORD@127.0.0.1:3306/DB_NAME"

# ── Authentication (Better Auth) ─────────────────────────────────────────────
# Generate with:  node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
BETTER_AUTH_SECRET="replace-with-a-long-random-secret"
BETTER_AUTH_URL="https://apollogroupr.tv"
# Set to "true" to enable auth rate limiting outside production (testing only).
AUTH_RATE_LIMIT="false"
# Local testing only: "true" skips email verification so new accounts can sign in immediately.
# Ignored unless BETTER_AUTH_URL points at localhost — keep it "false" (or unset) on the server.
AUTH_SKIP_EMAIL_VERIFICATION="false"

# Payments
# Local sandbox: simulated BTC price and blockchain, with test buttons in the payment window.
# Ignored unless BETTER_AUTH_URL points at localhost — keep it "false" (or unset) on the server.
PAYMENTS_SANDBOX="false"
# Secret for the payment-check cron job: GET /api/cron/payments with "Authorization: Bearer <CRON_SECRET>".
# Run it every 5 minutes so Bitcoin payments confirm even after the customer closes the page. 16+ characters.
CRON_SECRET=""

# ── Email (SMTP) — required for verification & password reset in production ─
# Hostinger email example: smtp.hostinger.com, port 465
SMTP_HOST=""
SMTP_PORT="465"
SMTP_USER=""
SMTP_PASSWORD=""
EMAIL_FROM="Apollo Group TV <no-reply@your-domain.com>"

# ── Payments (not integrated yet) ────────────────────────────────────────────
# One of: stripe | paddle | paypal. Checkout stays disabled until an adapter is
# implemented — see HOSTINGER_DEPLOYMENT.md → "Enabling payments".
PAYMENT_PROVIDER=""
PAYMENT_SECRET_KEY=""
PAYMENT_WEBHOOK_SECRET=""

# ── SEO & analytics (optional) ───────────────────────────────────────────────
# Google Search Console HTML-tag verification token (content value only).
GOOGLE_SITE_VERIFICATION=""
# Analytics measurement ID — not wired to a script yet; see README.
NEXT_PUBLIC_ANALYTICS_ID=""
# Set to "false" on staging to block all crawling via robots.txt.
ALLOW_INDEXING="true"

# Comma-separated HTTPS hostnames allowed for optimized remote images (channel logos).
NEXT_PUBLIC_IMAGE_HOSTS=""
